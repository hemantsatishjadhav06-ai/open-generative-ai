# Aquora runs on its own AI backend: media generation on fal.ai, text/agents on
# OpenRouter. Every variable below is SERVER-ONLY — set them as runtime
# variables (Railway → Variables), never as NEXT_PUBLIC_* and never as Docker
# build ARGs. The browser never sees these keys.

# ── AI providers ────────────────────────────────────────────────────────────
# fal.ai API-scope key (https://fal.ai/dashboard/keys). Required for images,
# video, audio, lip-sync and uploads.
FAL_KEY=
# OpenRouter key (https://openrouter.ai/keys). Required for prompt tools,
# agents, the design agent, workflow text nodes and clipping highlights.
OPENROUTER_API_KEY=
# Optional fal ADMIN-scope key, only for the owner balance endpoint.
FAL_ADMIN_KEY=

# ── Access gate (required in production) ────────────────────────────────────
# Comma-separated access codes, one per person. Everyone signed in with the
# same code shares one workspace. Removing a code signs its sessions out.
# The code is the only credential: production ignores codes shorter than 12
# characters or with fewer than 6 different characters (a warning with the
# count is logged). Generate one per person with: openssl rand -base64 18
# In production without (strong) codes every paid endpoint answers 503
# setup_required; in local development (NODE_ENV != production) the gate is open.
AQUORA_ACCESS_CODES=
# At least 32 bytes; signs the session cookie and job tokens. To rotate, put
# the new secret first and keep the old one after a comma for a while:
#   AQUORA_SESSION_SECRET=new-secret,old-secret
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AQUORA_SESSION_SECRET=

# ── Spend limits (estimated USD per UTC day) ────────────────────────────────
# Whole deployment:
AQUORA_DAILY_BUDGET_USD=25
# Per workspace (access code):
AQUORA_SESSION_DAILY_BUDGET_USD=10
# Every OpenRouter call reserves its worst case (prompt + max_tokens at the
# model's OpenRouter price) before it is sent and settles to the real cost.
# Prices for models OpenRouter doesn't list (USD per million tokens):
AQUORA_LLM_PROMPT_USD_PER_MTOK=5
AQUORA_LLM_COMPLETION_USD_PER_MTOK=25
# AI Clipping: transcription priced per minute of the uploaded video, and the
# longest video accepted.
AQUORA_TRANSCRIBE_USD_PER_MINUTE=0.006
AQUORA_CLIPPING_MAX_MINUTES=120

# ── Storage ─────────────────────────────────────────────────────────────────
# JSON document store (agents, workflows, design-agent sessions, jobs, the
# budget ledger). Defaults to /data when writable (mount a Railway volume
# there), else ./.aquora-data. /api/health reports storage=ephemeral when the
# data would be lost on redeploy.
AQUORA_DATA_DIR=

# ── OpenRouter models (optional overrides) ──────────────────────────────────
# Prompt enhance, suggestions, clipping scoring:
OPENROUTER_MODEL_FAST=openai/gpt-6-luna
# Agents, design agent, workflow architect:
OPENROUTER_MODEL_AGENT=anthropic/claude-sonnet-5
# Image understanding:
OPENROUTER_MODEL_VISION=google/gemini-3.8-flash
# Extra models the UI may request by name (comma-separated):
OPENROUTER_ALLOWED_MODELS=

# ── Networking (optional) ───────────────────────────────────────────────────
# Extra origins allowed to POST to the API (the site's own host always is):
AQUORA_ALLOWED_ORIGINS=
# Reverse proxies in front of the app. The client IP is the X-Forwarded-For
# entry appended by the nearest proxy (Railway: 1). Set 0 when the app is
# reached directly (no proxy): no forwarding header is trusted then.
AQUORA_TRUSTED_PROXY_HOPS=1
# Optional: a header your proxy OVERWRITES with the client IP (e.g.
# x-real-ip). Leave empty unless you are sure: clients can send any header.
AQUORA_CLIENT_IP_HEADER=

# ── Tests / local mock only (leave unset in production) ─────────────────────
# `npm run mock:upstream` starts a local fal.ai + OpenRouter stand-in on
# MOCK_UPSTREAM_PORT (default 4010); point the gateway at it with:
# FAL_QUEUE_BASE=http://127.0.0.1:4010/fal-queue
# FAL_RUN_BASE=http://127.0.0.1:4010/fal-run
# FAL_REST_BASE=http://127.0.0.1:4010/fal-rest
# FAL_API_BASE=http://127.0.0.1:4010/fal-api
# OPENROUTER_BASE_URL=http://127.0.0.1:4010/openrouter/api/v1
# MOCK_POLLS_TO_COMPLETE=2
# FAL_POLL_INTERVAL_MS=1500

# ── Build-time (public) ─────────────────────────────────────────────────────
# URL of the Reelty deployment embedded in the Reelty tab (build-time; also allowed in the CSP frame-src). Leave unset to use the hosted instance.
NEXT_PUBLIC_REELTY_URL=
